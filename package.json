{
    "name": "reporter-liquid-preview",
    "displayName": "Reporter Liquid Preview",
    "description": "Preview, edit, format and test Reporter Liquid templates",
    "version": "1.18.0",
    "publisher": "DGBooth",
    "license": "MIT",
    "engines": {
        "vscode": "^1.78.0"
    },
    "icon": "icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/DGBooth/vscode-reporter-liquid-preview"
    },
    "galleryBanner": {
        "color": "#0F6378",
        "theme": "dark"
    },
    "categories": [
        "Programming Languages",
        "Formatters",
        "Testing",
        "Other"
    ],
    "keywords": [
        "Reporter",
        "Liquid",
        "Template",
        "Live Preview",
        "Testing"
    ],
    "activationEvents": [
        "onLanguage:liquid",
        "onCommand:reporterLiquidPreview.preview",
        "onCommand:reporterLiquidPreview.htmlPreview",
        "onCommand:reporterLiquidPreview.fullHtmlPreview",
        "onCommand:reporterLiquidPreview.exportSpec",
        "onCommand:reporterLiquidPreview.runTemplateTests",
        "onCommand:reporterLiquidPreview.showTemplateTestReport",
        "onCommand:reporterLiquidPreview.acceptTemplateTestOutput",
        "onCommand:reporterLiquidPreview.createTemplateTests",
        "onCommand:reporterLiquidPreview.checkForUpdates",
        "workspaceContains:**/*.liquidtest.json"
    ],
    "main": "./extension.js",
    "bin": {
        "liquid-test": "bin/liquid-test.js"
    },
    "contributes": {
        "languages": [
            {
                "id": "liquid",
                "aliases": [
                    "Liquid",
                    "liquid"
                ],
                "extensions": [
                    ".liquid"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "liquid",
                "scopeName": "text.html.liquid",
                "path": "./syntaxes/liquid.tmLanguage.json",
                "embeddedLanguages": {
                    "source.css": "css",
                    "source.js": "javascript"
                }
            }
        ],
        "jsonValidation": [
            {
                "fileMatch": "*.liquidtest.json",
                "url": "./schemas/liquidtest.schema.json"
            }
        ],
        "commands": [
            {
                "command": "reporterLiquidPreview.preview",
                "title": "Reporter Liquid: Open Preview to the Side"
            },
            {
                "command": "reporterLiquidPreview.htmlPreview",
                "title": "Reporter Liquid: Open HTML Preview to the Side"
            },
            {
                "command": "reporterLiquidPreview.fullHtmlPreview",
                "title": "Reporter Liquid: Open Template Spec (Full HTML Preview) to the Side"
            },
            {
                "command": "reporterLiquidPreview.exportSpec",
                "title": "Reporter Liquid: Export Template Spec to Share or Print"
            },
            {
                "command": "reporterLiquidPreview.runTemplateTests",
                "title": "Reporter Liquid: Run Template Tests"
            },
            {
                "command": "reporterLiquidPreview.showTemplateTestReport",
                "title": "Reporter Liquid: Show Template Test Report"
            },
            {
                "command": "reporterLiquidPreview.acceptTemplateTestOutput",
                "title": "Reporter Liquid: Accept Actual Output as Expected"
            },
            {
                "command": "reporterLiquidPreview.createTemplateTests",
                "title": "Reporter Liquid: Create Tests from Data Files…"
            },
            {
                "command": "reporterLiquidPreview.checkForUpdates",
                "title": "Reporter Liquid: Check for Updates"
            }
        ],
        "configuration": {
            "title": "Reporter Liquid Preview",
            "properties": {
                "reporterLiquidPreview.checkForUpdates": {
                    "type": "boolean",
                    "default": true,
                    "description": "Once a day, when the extension starts, check GitHub for a newer release and offer to install it. \"Reporter Liquid: Check for Updates\" checks on demand either way."
                },
                "reporterLiquidPreview.dataFolders": {
                    "type": "array",
                    "items": { "type": "string" },
                    "default": [],
                    "description": "Where data files (the .json crawl results) are kept, so other .json files aren't offered. Folders or globs, from the workspace folder: crawl-results, data/**/crawl-*.json. Empty looks everywhere.",
                    "markdownDescription": "Where data files (the `.json` crawl results) are kept, so other `.json` files aren't offered when you pick data for a preview or create tests. Folders or globs, from the workspace folder: `crawl-results`, `**/crawls`, `data/**/crawl-*.json`. A folder name is that folder at the workspace folder; `**/` goes to any depth. Empty looks everywhere."
                },
                "reporterLiquidPreview.dataLinks": {
                    "type": "array",
                    "default": [],
                    "items": {
                        "type": "object",
                        "required": ["template", "data"],
                        "properties": {
                            "template": {
                                "type": "string",
                                "description": "The template, by name or glob: non-advised-letter.liquid, letters/*.liquid. A name on its own matches in any folder."
                            },
                            "data": {
                                "description": "The data files it's used with, by name or glob, or a list of them: NAL-*.json.",
                                "oneOf": [
                                    { "type": "string" },
                                    { "type": "array", "items": { "type": "string" } }
                                ]
                            }
                        }
                    },
                    "description": "Which data files go with which template. A template listed here is offered only those data files (with a way to see them all) when you pick data for a preview or create tests.",
                    "markdownDescription": "Which data files go with which template. A template listed here is offered only those data files, with a way to see all of them, when you pick data for a preview or create tests.\n\n```json\n[{ \"template\": \"non-advised-letter.liquid\", \"data\": \"NAL-*.json\" }]\n```\n\nPatterns are globs on the path from the workspace folder, capitals not mattering. A name on its own (`NAL-*.json`) matches in any folder; one with a `/` starts at the workspace folder."
                },
                "reporterLiquidPreview.autoClose": {
                    "type": "boolean",
                    "default": true,
                    "description": "In .liquid files: starting a block tag adds its end tag (Tab goes between them), typing a tag's %} yourself removes the extra one VS Code had added, and typing an HTML tag's > adds its closing tag. Opening a tag ({% or {{ gives its closer) is VS Code's own editor.autoClosingBrackets."
                },
                "reporterLiquidPreview.format.printWidth": {
                    "type": "integer",
                    "default": 120,
                    "minimum": 40,
                    "description": "Format Document wraps lines longer than this."
                },
                "reporterLiquidPreview.selectPdf.pageSize": {
                    "type": "string",
                    "enum": [
                        "A0",
                        "A1",
                        "A2",
                        "A3",
                        "A4",
                        "A5",
                        "A6",
                        "A7",
                        "A8",
                        "A9",
                        "A10",
                        "B0",
                        "B1",
                        "B2",
                        "B3",
                        "B4",
                        "B5",
                        "ArchA",
                        "ArchB",
                        "ArchC",
                        "ArchD",
                        "ArchE",
                        "Letter",
                        "HalfLetter",
                        "Letter11x17",
                        "Note",
                        "Flsa",
                        "Ledger"
                    ],
                    "default": "A4",
                    "markdownDescription": "SelectPdf pages: `HtmlToPdfOptions.PdfPageSize`. Ignored when `#reporterLiquidPreview.selectPdf.customPageSize#` is set."
                },
                "reporterLiquidPreview.selectPdf.customPageSize": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "default": null,
                    "properties": {
                        "width": {
                            "type": "number",
                            "minimum": 1
                        },
                        "height": {
                            "type": "number",
                            "minimum": 1
                        }
                    },
                    "markdownDescription": "SelectPdf pages: `HtmlToPdfOptions.PdfPageCustomSize`, in points: `{ \"width\": 595.28, \"height\": 841.89 }`."
                },
                "reporterLiquidPreview.selectPdf.orientation": {
                    "type": "string",
                    "enum": [
                        "Portrait",
                        "Landscape"
                    ],
                    "default": "Portrait",
                    "markdownDescription": "SelectPdf pages: `HtmlToPdfOptions.PdfPageOrientation`."
                },
                "reporterLiquidPreview.selectPdf.marginTop": {
                    "type": "number",
                    "default": 0,
                    "minimum": 0,
                    "markdownDescription": "SelectPdf pages: `HtmlToPdfOptions.MarginTop`, in points (1pt = 1/72in). Set it to what the code that converts the documents sets."
                },
                "reporterLiquidPreview.selectPdf.marginRight": {
                    "type": "number",
                    "default": 0,
                    "minimum": 0,
                    "markdownDescription": "SelectPdf pages: `HtmlToPdfOptions.MarginRight`, in points (1pt = 1/72in). Set it to what the code that converts the documents sets."
                },
                "reporterLiquidPreview.selectPdf.marginBottom": {
                    "type": "number",
                    "default": 0,
                    "minimum": 0,
                    "markdownDescription": "SelectPdf pages: `HtmlToPdfOptions.MarginBottom`, in points (1pt = 1/72in). Set it to what the code that converts the documents sets."
                },
                "reporterLiquidPreview.selectPdf.marginLeft": {
                    "type": "number",
                    "default": 0,
                    "minimum": 0,
                    "markdownDescription": "SelectPdf pages: `HtmlToPdfOptions.MarginLeft`, in points (1pt = 1/72in). Set it to what the code that converts the documents sets."
                },
                "reporterLiquidPreview.selectPdf.webPageWidth": {
                    "type": "integer",
                    "default": 1024,
                    "minimum": 100,
                    "markdownDescription": "SelectPdf pages: `HtmlToPdfOptions.WebPageWidth`, the width in px the document is laid out at before it is scaled to fit between the page margins. Smaller makes everything larger on the page."
                },
                "reporterLiquidPreview.selectPdf.cssMediaType": {
                    "type": "string",
                    "enum": [
                        "Screen",
                        "Print"
                    ],
                    "default": "Screen",
                    "markdownDescription": "SelectPdf pages: `HtmlToPdfOptions.CssMediaType`. With `Print`, `@media print` styles apply and a table's `thead` with `display: table-header-group` repeats on each page."
                },
                "reporterLiquidPreview.selectPdf.fitWideContent": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "SelectPdf pages: `HtmlToPdfOptions.FitWideContent`: a document wider than the web page width is laid out as wide as it needs (up to four times) and scaled down, rather than cut off at the right."
                },
                "reporterLiquidPreview.selectPdf.allowContentHeightResize": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "SelectPdf pages: `HtmlToPdfOptions.AllowContentHeightResize`: the last page is shortened to where the content ends."
                },
                "reporterLiquidPreview.selectPdf.customCss": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "SelectPdf pages: `HtmlToPdfOptions.CustomCSS`, CSS added after the document's own."
                },
                "reporterLiquidPreview.selectPdf.header": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "default": null,
                    "properties": {
                        "display": {
                            "type": "boolean",
                            "description": "HtmlToPdfOptions.DisplayHeader: show the header."
                        },
                        "height": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Header.Height, in points."
                        },
                        "displayOnFirstPage": {
                            "type": "boolean",
                            "default": true,
                            "description": "Header.DisplayOnFirstPage."
                        },
                        "displayOnOddPages": {
                            "type": "boolean",
                            "default": true,
                            "description": "Header.DisplayOnOddPages."
                        },
                        "displayOnEvenPages": {
                            "type": "boolean",
                            "default": true,
                            "description": "Header.DisplayOnEvenPages."
                        }
                    },
                    "markdownDescription": "SelectPdf pages: the header band, as `HtmlToPdfOptions.DisplayHeader` and `converter.Header` set it: `{ \"display\": true, \"height\": 50 }` (points). Its height comes off every page's content area; the view marks the band but doesn't render what goes in it."
                },
                "reporterLiquidPreview.selectPdf.footer": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "default": null,
                    "properties": {
                        "display": {
                            "type": "boolean",
                            "description": "HtmlToPdfOptions.DisplayFooter: show the footer."
                        },
                        "height": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Footer.Height, in points."
                        },
                        "displayOnFirstPage": {
                            "type": "boolean",
                            "default": true,
                            "description": "Footer.DisplayOnFirstPage."
                        },
                        "displayOnOddPages": {
                            "type": "boolean",
                            "default": true,
                            "description": "Footer.DisplayOnOddPages."
                        },
                        "displayOnEvenPages": {
                            "type": "boolean",
                            "default": true,
                            "description": "Footer.DisplayOnEvenPages."
                        }
                    },
                    "markdownDescription": "SelectPdf pages: the footer band, as `HtmlToPdfOptions.DisplayFooter` and `converter.Footer` set it: `{ \"display\": true, \"height\": 50 }` (points). Its height comes off every page's content area; the view marks the band but doesn't render what goes in it."
                }
            }
        },
        "menus": {
            "explorer/context": [
                {
                    "command": "reporterLiquidPreview.createTemplateTests",
                    "when": "resourceExtname == .liquid",
                    "group": "reporterLiquid"
                }
            ],
            "editor/context": [
                {
                    "command": "reporterLiquidPreview.createTemplateTests",
                    "when": "editorLangId == liquid",
                    "group": "reporterLiquid"
                },
                {
                    "command": "reporterLiquidPreview.exportSpec",
                    "when": "editorLangId == liquid",
                    "group": "reporterLiquid"
                }
            ]
        },
        "keybindings": [
            {
                "command": "reporterLiquidPreview.preview",
                "key": "ctrl+k v",
                "when": "editorLangId == liquid"
            },
            {
                "command": "reporterLiquidPreview.htmlPreview",
                "key": "ctrl+k h",
                "when": "editorLangId == liquid"
            },
            {
                "command": "reporterLiquidPreview.fullHtmlPreview",
                "key": "ctrl+k f",
                "when": "editorLangId == liquid"
            }
        ],
        "configurationDefaults": {
            "[liquid]": {
                "editor.defaultFormatter": "DGBooth.reporter-liquid-preview"
            }
        }
    },
    "scripts": {
        "test": "node --test test/*.test.js",
        "package": "npx --yes @vscode/vsce@2.32.0 package --baseContentUrl https://github.com/DGBooth/vscode-reporter-liquid-preview/blob/HEAD --baseImagesUrl https://github.com/DGBooth/vscode-reporter-liquid-preview/raw/HEAD",
        "check:package": "node scripts/check-package.js",
        "test:templates": "node bin/liquid-test.js examples"
    },
    "devDependencies": {
        "@types/vscode": "^1.32.0",
        "jsdom": "^26.1.0",
        "vscode-oniguruma": "^2.0.1",
        "vscode-textmate": "^9.3.2"
    },
    "dependencies": {
        "@shopify/prettier-plugin-liquid": "1.11.2",
        "css-select": "^5.2.2",
        "liquidjs": "^8.4.1",
        "parse5": "^7.3.0",
        "parse5-htmlparser2-tree-adapter": "^7.1.0",
        "prettier": "3.9.9",
        "vscode-html-languageservice": "5.6.2"
    }
}
