{
    "name": "reporter-liquid-preview",
    "displayName": "Reporter Liquid Preview",
    "description": "Live preview for Reporter Liquid templates",
    "version": "1.5.0",
    "publisher": "DGBooth",
    "engines": {
        "vscode": "^1.32.0"
    },
    "icon": "icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/DGBooth/vscode-reporter-liquid-preview"
    },
    "galleryBanner": {
        "color": "#0F6378",
        "theme": "dark"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "Reporter",
        "Liquid",
        "Template",
        "Live Preview",
        "Testing"
    ],
    "activationEvents": [
        "onCommand:reporterLiquidPreview.preview",
        "onCommand:reporterLiquidPreview.htmlPreview",
        "onCommand:reporterLiquidPreview.fullHtmlPreview",
        "onCommand:reporterLiquidPreview.runTemplateTests",
        "onCommand:reporterLiquidPreview.showTemplateTestReport",
        "onCommand:reporterLiquidPreview.acceptTemplateTestOutput",
        "onCommand:reporterLiquidPreview.createTemplateTests",
        "workspaceContains:**/*.liquidtest.json"
    ],
    "main": "./extension.js",
    "bin": {
        "liquid-test": "bin/liquid-test.js"
    },
    "contributes": {
        "languages": [
            {
                "id": "liquid",
                "extensions": [
                    ".liquid"
                ]
            }
        ],
        "jsonValidation": [
            {
                "fileMatch": "*.liquidtest.json",
                "url": "./schemas/liquidtest.schema.json"
            }
        ],
        "commands": [
            {
                "command": "reporterLiquidPreview.preview",
                "title": "Reporter Liquid: Open Preview to the Side"
            },
            {
                "command": "reporterLiquidPreview.htmlPreview",
                "title": "Reporter Liquid: Open HTML Preview to the Side"
            },
            {
                "command": "reporterLiquidPreview.fullHtmlPreview",
                "title": "Reporter Liquid: Open Full HTML Preview to the Side"
            },
            {
                "command": "reporterLiquidPreview.runTemplateTests",
                "title": "Reporter Liquid: Run Template Tests"
            },
            {
                "command": "reporterLiquidPreview.showTemplateTestReport",
                "title": "Reporter Liquid: Show Template Test Report"
            },
            {
                "command": "reporterLiquidPreview.acceptTemplateTestOutput",
                "title": "Reporter Liquid: Accept Actual Output as Expected"
            },
            {
                "command": "reporterLiquidPreview.createTemplateTests",
                "title": "Reporter Liquid: Create Tests from Data Files…"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "reporterLiquidPreview.createTemplateTests",
                    "when": "resourceExtname == .liquid",
                    "group": "reporterLiquid"
                }
            ],
            "editor/context": [
                {
                    "command": "reporterLiquidPreview.createTemplateTests",
                    "when": "editorLangId == liquid",
                    "group": "reporterLiquid"
                }
            ]
        },
        "keybindings": [
            {
                "command": "reporterLiquidPreview.preview",
                "key": "ctrl+k v",
                "when": "editorLangId == liquid"
            },
            {
                "command": "reporterLiquidPreview.htmlPreview",
                "key": "ctrl+k h",
                "when": "editorLangId == liquid"
            },
            {
                "command": "reporterLiquidPreview.fullHtmlPreview",
                "key": "ctrl+k f",
                "when": "editorLangId == liquid"
            }
        ]
    },
    "scripts": {
        "test": "node --test test/*.test.js",
        "package": "npx --yes @vscode/vsce@2.32.0 package --baseContentUrl https://github.com/DGBooth/vscode-reporter-liquid-preview/blob/HEAD --baseImagesUrl https://github.com/DGBooth/vscode-reporter-liquid-preview/raw/HEAD",
        "check:package": "node scripts/check-package.js",
        "test:templates": "node bin/liquid-test.js examples"
    },
    "devDependencies": {
        "@types/vscode": "^1.32.0"
    },
    "dependencies": {
        "css-select": "^5.2.2",
        "liquidjs": "^8.4.1",
        "parse5": "^7.3.0",
        "parse5-htmlparser2-tree-adapter": "^7.1.0"
    }
}
